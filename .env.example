# Copy to .env for local development. The app does NOT load .env by itself:
#   npm run start:local          (uses node --env-file=.env)
# or export the variables in your shell before `npm start`.
# On Render, set these in the service Environment settings instead.

# --- Service ---
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
ALLOWED_ORIGIN=*
# Leave blank for local development. SET THIS before exposing the service publicly.
MINDSCAPE_API_KEY=

# --- Current provider routes (see README.md) ---
IMAGE_PROVIDER=google
IMAGE_MODEL=gemini-3.1-flash-image
VIDEO_PROVIDER=qwencloud
VIDEO_RESOLUTION=720P
VISION_MODEL=gemini-3.8-flash
QWEN_I2V_MODEL=wan2.7-i2v
QWEN_T2V_MODEL=wan2.7-t2v

# --- Required credentials for real generation / evaluation ---
GEMINI_API_KEY=
QWEN_CLOUD_API_KEY=
# Alternative to QWEN_CLOUD_API_KEY for DashScope:
DASHSCOPE_API_KEY=

# --- Optional provider overrides / fallbacks (leave blank unless used) ---
QWEN_VIDEO_API_BASE=https://maas.qwencloudapi.com/api/v1
QWEN_TASK_API_BASE=https://dashscope-intl.aliyuncs.com/api/v1
QWEN_VIDEO_TIMEOUT_MS=900000
QWEN_VIDEO_POLL_INTERVAL_MS=15000
PIXAZO_API_KEY=
REPLICATE_API_TOKEN=
FAL_KEY=
HF_TOKEN=
HF_SPACE_NAME=zerogpu-aoti/wan2-2-fp8da-aoti-faster
HF_IMAGE_SPACE_NAME=Qwen/Qwen-Image-2.1
OMNIROUTE_ENABLED=false
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=

# --- Evaluation / auto-correction (off by default) ---
ENABLE_VISUAL_EVALUATION=false
ENABLE_AUTO_CORRECTION=false

# --- Job polling ---
PROVIDER_POLL_INTERVAL_MS=5000
PROVIDER_POLL_TIMEOUT_MS=900000

# --- Storage ---
# Local persistence must be under /var/data to be reported as durable;
# otherwise storage is reported as ephemeral. Any writable path works locally.
PERSISTENT_STORAGE_DIR=
STORAGE_PERSISTENCE_ENABLED=false

# Recommended durable storage: Cloudflare R2 (S3-compatible API).
# Leave all four credentials blank to bypass object storage entirely; the app
# then uses local files only and reports storage as ephemeral.
# R2 endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_PREFIX=mindscape-studio

# ffmpeg used for frame extraction / video stitching.
# ffmpeg-static is used by default; set this to a system binary if its
# download is blocked (e.g. npm install-scripts restrictions).
FFMPEG_BIN=
